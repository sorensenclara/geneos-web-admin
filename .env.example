# Copiá este archivo como .env y ajustá las rutas. No subas .env al repositorio.
DEBUG=1
# Repositorio de la web institucional de GENEOS (solo para ese sitio). No se modifica.
# Los sitios comerciales (GERP, GEAGRO, GEMA) no lo usan: tienen su base propia en renderer/base/.
GENEOS_WEB_DIR=../GENEOS WEB

# Servidor (cuando Infra lo defina)
# DEBUG=0
# SECRET_KEY=una-clave-larga-y-secreta
# ALLOWED_HOSTS=admin.geneos.com.ar
# CSRF_TRUSTED_ORIGINS=https://admin.geneos.com.ar
# GWA_URL_PUBLICA=https://admin.geneos.com.ar        # donde las webs envían los pedidos de demo
# GWA_CORS_EXTRA=https://gerp.ar,https://geagro.ar,https://gema.geneos.com.ar
# DB_NAME=gwa  DB_USER=gwa  DB_PASSWORD=…  DB_HOST=localhost
# EMAIL_HOST=smtp…  EMAIL_PORT=587  EMAIL_HOST_USER=…  EMAIL_HOST_PASSWORD=…  DEFAULT_FROM_EMAIL=web@geneos.com.ar

# «Actualidad e ideas para publicar» · YouTube Data API v3 (gratuita, sin facturación). La clave queda solo en el servidor.
# YOUTUBE_API_KEY=AIza…
